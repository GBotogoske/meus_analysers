#include "opticaldetectormodules.fcl"
#include "services_refactored_pdune.fcl"
#include "backtrackerservice.fcl"
#include "photonbacktrackerservice.fcl"
#include "particleinventoryservice.fcl"

process_name: flashmatchMC

services:
{
  TFileService: { fileName: "flash_info.root" }
  TimeTracker:       {}
  MemoryTracker:     {} # default is one
  RandomNumberGenerator: {} #ART native random number generator
  message:      @local::standard_info

  @table::protodunehd_refactored_simulation_services
  BackTrackerService: @local::standard_backtrackerservice
  PhotonBackTrackerService: @local::standard_photonbacktrackerservice
  ParticleInventoryService:   @local::standard_particleinventoryservice
  DetectorClocksService:        @local::protodunehd_detectorclocks


  NuRandomService:       @local::dune_prod_seedservice
}

services.BackTrackerService.BackTracker.G4ModuleLabel: "largeant"
services.PhotonBackTrackerService.PhotonBackTracker.G4ModuleLabel:  @erase 
services.PhotonBackTrackerService.PhotonBackTracker.G4ModuleLabels: ["PDFastSim", "PDFastSimExternal"]
services.PhotonBackTrackerService.PhotonBackTracker.Delay: -250e3

services.BackTrackerService.BackTracker.SimChannelModuleLabel: "tpcrawdecoder:simpleSC"

source:
{
  module_type: RootInput
  maxEvents:  30000
  fileNames: ["cosmics_reco.root"]
}

physics:
{
 analyzers:
 {
    flashinfo:
    {
        module_type: "MyFlashMatchingMC"
        FlashLabel: "opflash"
        SliceLabel: "pandora"
        TrackLabel: "pandoraTrack"
        ShowerLabel: "pandoraShower"
        PFParticleLabel: "pandora"
        ClusterType: "Slice"
        DetectorZone: "All" 
        getShowers: true
        limitMinFlash: 50.0
        limitMinFlashSide: 20.0 
        trackLengthMin: 30.0 #cm
    }
 }
 ana:  [ flashinfo ]
 end_paths:     [ana]
 
}

outputs:
{
}

services.TFileService.fileName: "%ifb_FlashMatchingMCAnalyser%ife"
